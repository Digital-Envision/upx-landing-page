# Microsoft Clarity (session recordings + heatmaps). Leave unset to disable.
# Inlined at build time, not runtime.
# Loaded from the root layout, so it covers the homepage AND all three service
# landing pages. The placeholder below is treated as "not configured" — replace
# it with the real project ID to switch Clarity on.
NEXT_PUBLIC_CLARITY_PROJECT_ID=your-clarity-project-id

# Google Tag Manager. Defaults to the production container (GTM-PJBWM82) when
# unset — only set this to point a preview deploy at a different container, or
# to an empty string to load no tag at all.
NEXT_PUBLIC_GTM_ID=GTM-PJBWM82

# ---------------------------------------------------------------------------
# Landing-page contact form (/api/contact)
#
# Every destination below is independently gated and fails soft: if one is
# disabled or errors, the others still receive the lead. The form only reports
# a failure to the visitor when ALL enabled destinations fail.
#
# Setup instructions: docs/landing-page-integrations.md
# ---------------------------------------------------------------------------

# 1) Email the team a new enquiry (SMTP2GO — same provider as vafe-landing)
NOTIFY_EMAIL_ENABLED=false
SMTP2GO_API_KEY=api-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTIFY_EMAIL_FROM=Upscalix <noreply@upscalix.com.au>
# One address, or several separated by commas
NOTIFY_EMAIL_TO=hello@upscalix.com.au

# 2) Append a row to the cloud spreadsheet
LEAD_SHEET_ENABLED=false

# "graph" (default) writes straight to an Excel workbook via Microsoft Graph.
# "webhook" POSTs the row to LEAD_SHEET_WEBHOOK_URL instead (Power Automate,
# Google Apps Script, Zapier…).
LEAD_SHEET_PROVIDER=graph

# --- provider: graph ---
# From the Entra app registration (see docs/landing-page-integrations.md).
LEAD_SHEET_TENANT_ID=
LEAD_SHEET_CLIENT_ID=
LEAD_SHEET_CLIENT_SECRET=
# The workbook's "Copy link" URL. Alternatively set LEAD_SHEET_DRIVE_ID and
# LEAD_SHEET_ITEM_ID to skip the one-off lookup.
LEAD_SHEET_WORKBOOK_URL=
LEAD_SHEET_DRIVE_ID=
LEAD_SHEET_ITEM_ID=
# Name of the *table* inside the workbook, not the sheet.
LEAD_SHEET_TABLE=Leads

# --- provider: webhook ---
LEAD_SHEET_WEBHOOK_URL=
# Optional. Only needed for endpoints that can't sign their own URL — Power
# Automate URLs already carry a SAS signature, Apps Script URLs do not.
LEAD_SHEET_SECRET=

# 3) Create a lead in Pulse (the Virtual-Office CRM) — a Contact, an optional
#    Company, and an unassigned Deal in the New stage. The page decides the
#    pipeline: the two staffing pages feed Staff, custom software feeds Project.
#    PULSE_SYNC_URL is the backend origin; /public/leads is appended.
#    PULSE_SYNC_SECRET must match the same variable on the Pulse backend.
#
#    TWO switches (CU-14ymjnvz3wn), because the endpoint writes three records
#    in one request and they are wanted separately:
#
#    PULSE_CRM_SYNC_ENABLED  — whether the call happens at all, which is what
#                              creates the CONTACT and the COMPANY. Falls back
#                              to the older PULSE_SYNC_ENABLED, so an existing
#                              environment keeps working untouched; set the new
#                              name on anything fresh.
#    PULSE_DEAL_SYNC_ENABLED — whether that same call also opens a DEAL. Off
#                              unless explicitly `true`.
#
#    The Deal is the one switched off. An Upscalix enquiry enters the Lead
#    Pipeline as a Lead (section 4), where opening a Deal is something a human
#    does once the lead is qualified — doing it here pre-empts that decision.
#    The Contact and the Company are wanted either way: a person and an
#    organisation really did get in touch.
PULSE_CRM_SYNC_ENABLED=false
PULSE_DEAL_SYNC_ENABLED=false
PULSE_SYNC_URL=https://pulse.internal
PULSE_SYNC_SECRET=change-me-shared-secret

# 4) Capture the same enquiry in Pulse's LEAD PIPELINE as a Lead — the
#    Marketing → Sales qualification board, which is a different record from
#    the Deal above and a different endpoint (/public/lead-capture). This is
#    the one that should be on: since CU-14ymjnvz3wn an enquiry produces a Lead
#    and nothing else unless the deal sync above is explicitly re-enabled.
#
#    Reuses PULSE_SYNC_URL and PULSE_SYNC_SECRET — same Pulse, same shared
#    secret, so there is no second credential to rotate. It has its own flag so
#    either record can be turned off without the other.
#
#    This is also what carries first-touch campaign attribution (utm_*, gclid).
#    Pulse stores those write-once when the Lead is created, so a lead captured
#    with this off can never be attributed afterwards.
PULSE_LEAD_CAPTURE_ENABLED=false
